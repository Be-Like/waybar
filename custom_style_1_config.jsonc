// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 34, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "hyprland/window"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "hyprland/window": {
        "max-length": 200,
        "separate-outputs": true
    },
    "modules-right": [
        // "custom/media",
        // "mpd",
        // "idle_inhibitor",
        // "mpris",
        "pulseaudio",
        // "network",
        // "cpu",
        // "memory",
        // "temperature",
        // "keyboard-state",
        "clock",
        "tray"
    ],

    // "mpris": { // Option for media player
	// 	"format": "{player_icon}",
	// 	"format-paused": "{status_icon}",
	// 	"player-icons": {
	// 		"default": "",
	// 		"mpv": "🎵"
	// 	},
	// 	"status-icons": {
	// 		"paused": ""
	// 	}
	// 	// "ignored-players": ["firefox"]
	// },
    // Modules configuration
    "hyprland/workspaces": {
        // "disable-scroll": true,
        // "all-outputs": true,
        // "warp-on-scroll": false,
        // "format": "{name}: {icon}",
        // "format-icons": {
        //     "1": "",
        //     "2": "",
        //     "3": "",
        //     "4": "",
        //     "5": "",
        //     "urgent": "",
        //     "focused": "",
        //     "default": ""
        // },
        "persistent-workspaces": {
            "DP-1": [9],
            "DP-2": [1, 3, 4, 10],
            "HDMI-A-1": [2]
        },
        "sort-by": "number",
        "format": "{icon} {windows}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "9": "",
            "10": "",
            "urgent": "",
            "focused": "",
            "default": ""
        },
        "window-rewrite-default": "",
        "window-rewrite": {
            "class<.*firefox.*>": "",
            "class<.*code-url-handler.*>": "",
            "class<.*jetbrains-webstorm.*>": "",
            "class<.*jetbrains-rubymine.*>": "", // Not a great solution, but works. Check back once Wayland is implemented properly
            "title<.*Spit.*>": "",
            "title<.*Zoom Workplace.*>": "",
            "class<kitty>": "",
            "class<.*Spotify.*>": ""
        }
    },
    // "keyboard-state": {
    //     "numlock": true,
    //     "capslock": true,
    //     "format": "{name} {icon}",
    //     "format-icons": {
    //         "locked": "",
